<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SubHub" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowSoftInputMode">stateAlwaysHidden|adjustResize</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface_card_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackgroundFloating">@color/surface_card_raised</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/control_checked_indicator</item>
        <item name="android:colorControlActivated">@color/control_checked_indicator</item>
        <item name="android:colorControlHighlight">@color/accent_glow</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.SubHub.Activity</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SubHub.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SubHub.AlertDialog</item>
        <item name="snackbarStyle">@style/Widget.SubHub.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.SubHub.SnackbarText</item>
        <item name="snackbarButtonStyle">@style/Widget.SubHub.SnackbarAction</item>
        <item name="android:buttonStyle">@style/Widget.SubHub.DefaultButton</item>
        <item name="android:editTextStyle">@style/Widget.SubHub.Input</item>
        <item name="editTextStyle">@style/Widget.SubHub.Input</item>
        <item name="switchStyle">@style/Widget.SubHub.Switch</item>
        <item name="android:checkboxStyle">@style/Widget.SubHub.CheckBox</item>
        <item name="checkboxStyle">@style/Widget.SubHub.CheckBox</item>
        <item name="android:radioButtonStyle">@style/Widget.SubHub.RadioButton</item>
        <item name="radioButtonStyle">@style/Widget.SubHub.RadioButton</item>
        <item name="spinnerStyle">@style/Widget.SubHub.Spinner</item>
    </style>

    <style name="Widget.SubHub.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_native_dialog</item>
        <item name="android:dropDownWidth">match_parent</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="popupTheme">@style/ThemeOverlay.SubHub.AlertDialog</item>
    </style>

    <style name="Animation.SubHub.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/subhub_page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/subhub_page_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/subhub_page_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/subhub_page_pop_exit</item>
    </style>

    <style name="Animation.SubHub.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/subhub_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/subhub_dialog_exit</item>
    </style>

    <style name="ThemeOverlay.SubHub.AlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowSoftInputMode">stateAlwaysHidden|adjustResize</item>
        <item name="android:windowAnimationStyle">@style/Animation.SubHub.Dialog</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- AppCompat dialogs also need a window surface; colorSurface alone is Material-builder-only. -->
        <item name="android:windowBackground">@drawable/bg_native_dialog</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SubHub.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SubHub.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.SubHub.DialogButton</item>
    </style>

    <style name="Widget.SubHub.DialogButton"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/outline_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="android:paddingHorizontal">@dimen/ui_control_padding</item>
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">@dimen/ui_text_body</item>
    </style>

    <style name="Widget.SubHub.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_notice</item>
        <item name="backgroundTint">@color/dialog_surface</item>
        <item name="actionTextColorAlpha">1.0</item>
        <item name="android:elevation">8dp</item>
        <item name="android:layout_margin">12dp</item>
    </style>
    <style name="Widget.SubHub.SnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/ui_text_body</item>
        <item name="android:maxLines">4</item>
    </style>
    <style name="Widget.SubHub.SnackbarAction" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

