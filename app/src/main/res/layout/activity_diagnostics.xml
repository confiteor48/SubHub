<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diagnostics_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/primary_header_top"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="24dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/censor_lab_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_section"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_lab_title" />

            <TextView
                android:id="@+id/censor_lab_status"
                style="@style/Widget.SubHub.DiagnosticsText"
                android:layout_marginTop="@dimen/ui_gap_control" />

            <TextView
                android:id="@+id/censor_lab_sync_marker"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:background="@color/accent"
                android:gravity="center"
                android:textColor="@color/background"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_censor_lab_start"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_lab_start" />

                <Button
                    android:id="@+id/button_censor_lab_stop"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_lab_stop" />
            </LinearLayout>

            <Button
                android:id="@+id/button_censor_lab_save"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/diagnostics_lab_save" />

            <Button
                android:id="@+id/button_censor_lab_attach"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/diagnostics_lab_share_bundle" />

            <Button
                android:id="@+id/button_censor_lab_share_trace"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/diagnostics_lab_share_trace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_section"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_runtime" />

            <TextView
                android:id="@+id/runtime_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_performance" />

            <TextView
                android:id="@+id/performance_status"
                style="@style/Widget.SubHub.DiagnosticsText" />

            <com.subhub.app.util.StateToggle
                android:id="@+id/switch_diagnostics_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/diagnostics_overlay" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_overlay_desc"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/ui_text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_configuration" />

            <TextView
                android:id="@+id/configuration_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_permissions" />

            <TextView
                android:id="@+id/permissions_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_build" />

            <TextView
                android:id="@+id/build_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <Button
            android:id="@+id/button_refresh"
            style="@style/Widget.SubHub.PrimaryButton"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:text="@string/diagnostics_refresh" />
    </LinearLayout>
</ScrollView>
