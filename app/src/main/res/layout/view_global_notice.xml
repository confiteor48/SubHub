<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/global_notice_host" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:orientation="vertical"
    android:paddingHorizontal="14dp" android:paddingBottom="@dimen/ui_gap_group" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/global_notice_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="@dimen/ui_text_row_title" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/global_notice_dismiss" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="×" android:textSize="@dimen/ui_icon_text" android:textColor="@color/text_secondary"
            android:contentDescription="@string/notice_dismiss" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    <TextView android:id="@+id/global_notice_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="@dimen/ui_text_label" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/global_notice_action" style="@style/Widget.SubHub.OutlineAction"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/ui_gap_control" />
</LinearLayout>
