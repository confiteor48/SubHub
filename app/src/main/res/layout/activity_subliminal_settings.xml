<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/primary_header_top" android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="32dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.subhub.app.util.StateToggle
            android:id="@+id/switch_whispers"
            style="@style/Widget.SubHub.SettingsToggle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:text="@string/atmosphere_whispers_toggle" />

        <LinearLayout android:id="@+id/intensity_card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/ui_gap_group">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/subliminal_intensity_title" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:layout_marginTop="@dimen/ui_gap_inline" android:text="@string/subliminal_intensity_help" />
            <TextView android:id="@+id/preset_value" style="@style/Widget.SubHub.FieldLabel"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.slider.Slider android:id="@+id/preset_slider"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/control_min_height"
                android:focusable="true" android:focusableInTouchMode="true"
                android:contentDescription="@string/subliminal_intensity_title"
                android:valueFrom="0" android:valueTo="3" android:stepSize="1"
                app:tickVisible="true" app:labelBehavior="floating" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/subliminal_preset_gentle"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:text="@string/subliminal_preset_normal"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:text="@string/subliminal_preset_strict"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="end"
                    android:text="@string/subliminal_preset_ultra"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
            </LinearLayout>
            <com.subhub.app.util.StateToggle
                android:id="@+id/advanced_enabled" style="@style/Widget.SubHub.SettingsToggle"
                android:layout_width="match_parent" android:text="@string/subliminal_advanced" />
            <LinearLayout android:id="@+id/advanced_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/opacity_label" style="@style/Widget.SubHub.FieldLabel" />
                <SeekBar android:id="@+id/opacity" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="14" />
                <TextView android:id="@+id/duration_label" style="@style/Widget.SubHub.FieldLabel" />
                <SeekBar android:id="@+id/duration" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="32" />
                <TextView android:id="@+id/min_interval_label" style="@style/Widget.SubHub.FieldLabel" />
                <SeekBar android:id="@+id/min_interval" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="295" />
                <TextView android:id="@+id/max_interval_label" style="@style/Widget.SubHub.FieldLabel" />
                <SeekBar android:id="@+id/max_interval" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="295" />
                <TextView android:id="@+id/text_size_label" style="@style/Widget.SubHub.FieldLabel" />
                <SeekBar android:id="@+id/text_size" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="14" />
            </LinearLayout>
            <TextView android:id="@+id/button_preview" style="@style/Widget.SubHub.OutlineAction"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:layout_marginTop="@dimen/ui_gap_group"
                android:text="@string/subliminal_preview" />
            <FrameLayout android:id="@+id/preview_stage" android:layout_width="match_parent"
                android:layout_height="120dp" android:layout_marginTop="@dimen/ui_gap_control" android:visibility="gone"
                android:background="@drawable/bg_header_card">
                <TextView android:id="@+id/preview_text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="@color/text_primary" android:textStyle="bold"
                    android:alpha="0" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/message_packs_card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/ui_gap_group">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/subliminal_packs_title" />
            <com.subhub.app.util.SelectionGrid android:id="@+id/message_packs_grid" android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <CheckBox android:id="@+id/pack_obedience" style="@style/Widget.SubHub.GridSelectionTile" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:buttonTint="@color/toggle_tint"
                android:text="@string/subliminal_pack_obedience" />
            <CheckBox android:id="@+id/pack_focus" style="@style/Widget.SubHub.GridSelectionTile" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:buttonTint="@color/toggle_tint"
                android:text="@string/subliminal_pack_focus" />
            <CheckBox android:id="@+id/pack_beta" style="@style/Widget.SubHub.GridSelectionTile" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:buttonTint="@color/toggle_tint"
                android:text="@string/subliminal_pack_beta" />
            <CheckBox android:id="@+id/pack_findom" style="@style/Widget.SubHub.GridSelectionTile" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:buttonTint="@color/toggle_tint"
                android:text="@string/subliminal_pack_findom" />
            <CheckBox android:id="@+id/pack_custom" style="@style/Widget.SubHub.GridSelectionTile" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height" android:buttonTint="@color/toggle_tint"
                android:text="@string/subliminal_pack_custom" />
            </com.subhub.app.util.SelectionGrid>
            <LinearLayout android:id="@+id/custom_phrases_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/subliminal_custom_title" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/subliminal_custom_help" />
            <EditText android:id="@+id/custom_phrases" style="@style/Widget.SubHub.Input" android:layout_width="match_parent"
                android:layout_height="150dp" android:layout_marginTop="@dimen/ui_gap_inline" android:gravity="top|start"
                android:hint="@string/subliminal_custom_hint" android:inputType="textMultiLine" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
