<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/primary_header_top"
            android:layout_marginBottom="@dimen/ui_gap_group" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_gap_group">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/update_status_title" />
            <TextView
                android:id="@+id/installed_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_text_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/available_version"
                style="@style/Widget.SubHub.FieldHelp"
                android:layout_marginTop="@dimen/ui_gap_inline" />
            <TextView
                android:id="@+id/last_checked"
                style="@style/Widget.SubHub.FieldHelp"
                android:layout_marginTop="@dimen/ui_gap_inline" />
            <TextView
                android:id="@+id/update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:textColor="@color/accent_text"
                android:textSize="@dimen/ui_text_caption"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/download_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:progressTint="@color/accent"
                android:visibility="gone" />
            <Button
                android:id="@+id/button_check"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ui_gap_group"
                android:text="@string/update_check_now" />
            <Button
                android:id="@+id/button_action"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/update_download"
                android:visibility="gone" />
            <Button
                android:id="@+id/button_cancel"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/update_cancel_download"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_gap_group">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/update_automatic_title" />
            <com.subhub.app.util.StateToggle
                android:id="@+id/automatic_checks"
                style="@style/Widget.SubHub.SettingsToggle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ui_gap_inline"
                android:text="@string/update_automatic_toggle" />
            <TextView
                android:id="@+id/automatic_help"
                style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/update_automatic_help" />
            <com.subhub.app.util.StateToggle
                android:id="@+id/dev_updates"
                style="@style/Widget.SubHub.SettingsToggle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/update_dev_toggle" />
            <TextView
                android:id="@+id/dev_updates_help"
                style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/update_dev_help" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/release_notes_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_gap_group"
            android:visibility="gone">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/update_release_notes" />
            <TextView
                style="@style/Widget.SubHub.FieldHelp"
                android:layout_marginTop="@dimen/ui_gap_inline"
                android:text="@string/update_history_help" />
            <LinearLayout
                android:id="@+id/release_history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/download_guide_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_gap_group"
            android:visibility="gone">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/update_download_options" />
            <TextView
                android:id="@+id/download_guide"
                style="@style/Widget.SubHub.FieldHelp"
                android:layout_marginTop="@dimen/ui_gap_control" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
