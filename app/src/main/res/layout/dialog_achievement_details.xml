<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_achievement_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <com.subhub.app.stats.AchievementBadgeView
        android:id="@+id/achievement_detail_badge"
        android:layout_width="148dp"
        android:layout_height="148dp" />

    <TextView
        android:id="@+id/achievement_detail_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_gap_group"
        android:includeFontPadding="false"

        android:textColor="@color/accent_hot"
        android:textSize="@dimen/ui_text_caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_detail_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_gap_control"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_detail_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_gap_control"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/ui_text_row_title" />

    <TextView
        android:id="@+id/achievement_detail_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_gap_group"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/accent_text"
        android:textSize="@dimen/ui_text_label"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_detail_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_gap_control"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/ui_text_caption" />

    <TextView
        android:id="@+id/achievement_detail_close"
        style="@style/Widget.SubHub.OutlineAction"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/control_min_height"
        android:layout_marginTop="20dp"
        android:text="@string/close" />
</LinearLayout>
