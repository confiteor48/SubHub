<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/primary_header_top"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="32dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Widget.SubHub.FieldHelp"
            android:layout_marginTop="@dimen/ui_gap_control"
            android:layout_marginBottom="@dimen/ui_gap_group"
            android:text="@string/export_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@string/export_current_settings"
                android:textColor="@color/accent_text"
                android:textSize="@dimen/ui_text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/export_settings_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ui_card_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_delete_originals_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/ui_text_label"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_gap_inline"
                    android:text="@string/export_delete_originals_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/ui_text_caption" />
            </LinearLayout>

            <com.subhub.app.util.StateToggle
                android:id="@+id/switch_delete_originals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_pick_images"
            style="@style/Widget.SubHub.PrimaryButton"
            android:layout_marginTop="@dimen/ui_gap_section"

            android:text="@string/export_pick_images" />

        <Button
            android:id="@+id/button_cancel_export"
            style="@style/Widget.SubHub.CompactOutlineButton"
            android:layout_marginTop="@dimen/ui_gap_control"
            android:text="@string/export_cancel"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/export_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/ui_card_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/export_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_text_body" />

            <ProgressBar
                android:id="@+id/export_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/ui_gap_group"
                android:progressBackgroundTint="@color/background"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/export_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_group"
                android:text="@string/export_saved_to"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/ui_text_caption"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
