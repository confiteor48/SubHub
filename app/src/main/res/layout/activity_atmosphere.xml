<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_main">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/bottom_nav_clearance">
            <include layout="@layout/view_primary_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/primary_header_top" />
            <LinearLayout android:id="@+id/rituals_packs_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:orientation="vertical" android:padding="@dimen/ui_card_padding" android:background="@drawable/bg_home_flat_bubble">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_nav_studio" android:importantForAccessibility="no" app:tint="@color/accent_text" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/rituals_packs" android:textSize="@dimen/ui_text_section" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/rituals_pack_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_label" />
                </LinearLayout>
                <TextView android:id="@+id/rituals_pack_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group" android:text="@string/rituals_no_packs" android:textSize="@dimen/ui_text_row_title" android:textColor="@color/text_primary" />
                <com.subhub.app.util.WalletBalanceRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group">
                    <Button android:id="@+id/rituals_import_pack" style="@style/Widget.SubHub.CompactOutlineButton" android:text="@string/rituals_import_pack" />
                    <Button android:id="@+id/rituals_pack_library" style="@style/Widget.SubHub.CompactOutlineButton" android:text="@string/rituals_pack_library" />
                </com.subhub.app.util.WalletBalanceRow>
            </LinearLayout>
            <LinearLayout android:id="@+id/rituals_gallery_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:orientation="horizontal" android:padding="@dimen/ui_card_padding" android:gravity="center_vertical" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_tab_export" android:importantForAccessibility="no" app:tint="@color/accent_text" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/export_workspace_title" android:textSize="@dimen/ui_text_section" android:textStyle="bold" android:textColor="@color/text_primary" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="12dp" android:src="@drawable/ic_wallet_chevron" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rituals_keyholder_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="0dp" android:src="@drawable/ic_keyholder" app:tint="@color/accent_mid" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/keyholder_home_title" android:textSize="@dimen/ui_text_section" android:textStyle="bold" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/rituals_keyholder_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" android:textColor="@color/accent_text" />
                    </LinearLayout>
                    <TextView android:id="@+id/button_keyholder" android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp" android:minWidth="48dp" android:text="" android:gravity="center" android:drawableEnd="@drawable/ic_wallet_chevron" android:paddingHorizontal="16dp" android:focusable="true" android:contentDescription="@string/keyholder_open" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/whispers_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/atmosphere_whispers_title" android:padding="0dp" android:src="@drawable/ic_subliminal_whisper_2" app:tint="@color/accent_mid" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/atmosphere_whispers_title" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" />
                        <TextView android:id="@+id/whispers_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:textColor="@color/accent_text" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/button_whispers" android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp" android:minWidth="48dp" android:text="" android:gravity="center" android:drawableEnd="@drawable/ic_wallet_chevron" android:paddingHorizontal="16dp" android:focusable="true" android:contentDescription="@string/atmosphere_shape_whispers" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/popup_storm_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/popup_title" android:padding="0dp" android:src="@drawable/ic_popup_storm" app:tint="@color/accent_hot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/popup_title" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" />
                        <TextView android:id="@+id/popup_storm_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:textColor="@color/accent_hot" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/button_popup_storm" android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp" android:minWidth="48dp" android:text="" android:gravity="center" android:drawableEnd="@drawable/ic_wallet_chevron" android:paddingHorizontal="16dp" android:focusable="true" android:contentDescription="@string/atmosphere_open_popup_storm" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/achievements_home_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="@dimen/ui_card_padding" android:layout_marginHorizontal="@dimen/page_margin">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/achievements_home_title" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" />
                    <TextView android:id="@+id/achievements_home_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_achievement_tag" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textColor="@color/accent_hot" android:textSize="@dimen/ui_text_label" android:textStyle="bold" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="@dimen/ui_gap_control" android:clipToPadding="false" android:scrollbars="none" android:requiresFadingEdge="horizontal" android:fadingEdgeLength="32dp">
                    <LinearLayout android:id="@+id/achievements_home_badges" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/achievements_home_next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_label" android:textStyle="bold" />
                    <TextView android:id="@+id/achievements_home_progress_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/accent_hot" android:textSize="@dimen/ui_text_label" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/achievements_home_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="@dimen/ui_gap_control" android:max="100" android:progressBackgroundTint="@color/outline_subtle" android:progressTint="@color/accent_hot" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
