                    <TextView android:id="@+id/button_other_areas" style="@style/Widget.SubHub.OutlineAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group" android:text="@string/censor_other_areas" />
                    <com.subhub.app.util.SelectionGrid android:id="@+id/other_area_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:visibility="gone">
                        <CheckBox android:id="@+id/switch_faces" style="@style/Widget.SubHub.SelectionTile" android:text="@string/category_faces" />
                        <CheckBox android:id="@+id/switch_male_chest" style="@style/Widget.SubHub.SelectionTile" android:text="@string/category_male_chest" />
                        <CheckBox android:id="@+id/switch_belly" style="@style/Widget.SubHub.SelectionTile" android:text="@string/category_belly" />
                        <CheckBox android:id="@+id/switch_feet" style="@style/Widget.SubHub.SelectionTile" android:text="@string/category_feet" />
                        <CheckBox android:id="@+id/switch_armpits" style="@style/Widget.SubHub.SelectionTile" android:text="@string/category_armpits" />
                    </com.subhub.app.util.SelectionGrid>
                    <com.subhub.app.util.StateToggle android:id="@+id/switch_covered" style="@style/Widget.SubHub.SettingsToggle" android:layout_width="match_parent" android:layout_marginTop="@dimen/ui_gap_control" android:text="@string/category_covered" />
                </LinearLayout>
                <LinearLayout android:id="@+id/censor_coverage_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group" android:orientation="vertical" android:padding="0dp">
                    <TextView style="@style/Widget.SubHub.FieldLabel" android:layout_marginTop="0dp" android:text="@string/censor_coverage_title" />
                    <com.subhub.app.util.CompactChoiceGroup android:id="@+id/coverage_group" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RadioButton android:id="@+id/radio_coverage_areas" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:buttonTint="@color/toggle_tint" android:text="@string/censor_coverage_areas" />
                        <RadioButton android:id="@+id/radio_coverage_person" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:buttonTint="@color/toggle_tint" android:text="@string/censor_coverage_person" />
                    </com.subhub.app.util.CompactChoiceGroup>
                </LinearLayout>
                <LinearLayout android:id="@+id/censor_text_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_group" android:orientation="vertical" android:padding="0dp">
                    <TextView style="@style/Widget.SubHub.FieldLabel" android:layout_marginTop="0dp" android:text="@string/text_smut_title" />
                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:columnCount="2">
                        <com.subhub.app.util.StateToggle android:id="@+id/switch_smut_text" style="@style/Widget.SubHub.SettingsToggle" android:layout_columnSpan="2" android:text="@string/text_smut_enable" />
                    </GridLayout>
                    <LinearLayout android:id="@+id/text_matching_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:text="@string/text_smut_sensitivity" />
                        <TextView style="@style/Widget.SubHub.FieldHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:text="@string/text_smut_sensitivity_help" />
                        <com.subhub.app.util.CompactChoiceGroup android:id="@+id/smut_sensitivity_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:orientation="horizontal">
                            <RadioButton android:id="@+id/radio_smut_strict" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:buttonTint="@color/toggle_tint" android:gravity="center_vertical" android:text="@string/text_smut_strict" />
                            <RadioButton android:id="@+id/radio_smut_balanced" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1.25" android:buttonTint="@color/toggle_tint" android:gravity="center_vertical" android:text="@string/text_smut_balanced" />
                            <RadioButton android:id="@+id/radio_smut_broad" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:buttonTint="@color/toggle_tint" android:gravity="center_vertical" android:text="@string/text_smut_broad" />
                        </com.subhub.app.util.CompactChoiceGroup>
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:text="@string/text_smut_categories" />
                        <com.subhub.app.util.SelectionGrid android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline">
                            <CheckBox android:id="@+id/switch_smut_explicit" style="@style/Widget.SubHub.GridSelectionTile" android:text="@string/text_smut_explicit" />
                            <CheckBox android:id="@+id/switch_smut_fetish" style="@style/Widget.SubHub.GridSelectionTile" android:text="@string/text_smut_fetish" />
                            <CheckBox android:id="@+id/switch_smut_solicitation" style="@style/Widget.SubHub.GridSelectionTile" android:text="@string/text_smut_solicitation" />
                        </com.subhub.app.util.SelectionGrid>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
