<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/primary_header_top" />

        <LinearLayout
            android:id="@+id/popup_configuration_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/settings_card_gap"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/popup_configuration" />

            <com.subhub.app.util.StateToggle
                android:id="@+id/switch_popup_storm"
                style="@style/Widget.SubHub.SettingsToggle"
                android:layout_width="match_parent"
                android:text="@string/atmosphere_popup_toggle" />

            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/popup_presets" />
            <TextView android:id="@+id/preset_value" style="@style/Widget.SubHub.FieldLabel"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/preset_hint" style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/popup_custom_intensity_help" />
            <com.google.android.material.slider.Slider android:id="@+id/preset_slider"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/control_min_height"
                android:focusable="true" android:focusableInTouchMode="true"
                android:contentDescription="@string/popup_presets"
                android:valueFrom="0" android:valueTo="3" android:stepSize="1"
                app:tickVisible="true" app:labelBehavior="floating" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/popup_preset_gentle" android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:gravity="center" android:text="@string/popup_preset_medium" android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:gravity="center" android:text="@string/popup_preset_intense" android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:gravity="end" android:text="@string/popup_preset_overload" android:textColor="@color/text_secondary" android:textSize="@dimen/ui_text_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/button_preview"
                    style="@style/Widget.SubHub.CompactOutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/control_min_height"
                    android:layout_weight="1"
                    android:text="@string/popup_preview" />
                <Button
                    android:id="@+id/button_stop"
                    style="@style/Widget.SubHub.CompactOutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/control_min_height"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/popup_stop_now" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popup_images_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/settings_card_gap"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/popup_library" />
            <TextView android:id="@+id/library_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/ui_text_caption" />
            <Button android:id="@+id/button_add_folder"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_marginTop="@dimen/ui_gap_control"
                android:text="@string/popup_add_folder" />
            <LinearLayout android:id="@+id/folders_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popup_advanced_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/settings_card_gap"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView android:id="@+id/button_advanced_details" style="@style/Widget.SubHub.SectionHeader"
                android:accessibilityHeading="true"
                android:minHeight="48dp" android:gravity="center_vertical"
                android:text="@string/popup_advanced" />
            <LinearLayout
                android:id="@+id/dynamic_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
