<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/paypal_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
    <TextView style="@style/Widget.SubHub.FieldHelp" android:layout_marginTop="@dimen/ui_gap_inline" android:text="@string/paypal_settings_help" />
    <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/paypal_environment_label" android:layout_marginTop="8dp" />
    <com.subhub.app.util.CompactChoiceGroup android:id="@+id/paypal_environment" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/paypal_environment_sandbox" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="@string/paypal_environment_sandbox" style="@style/Widget.SubHub.OptionRadio" />
        <RadioButton android:id="@+id/paypal_environment_live" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="@string/paypal_environment_live" style="@style/Widget.SubHub.OptionRadio" />
    </com.subhub.app.util.CompactChoiceGroup>
    <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/paypal_environment_help" />
    <TextView android:id="@+id/paypal_sandbox_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:textColor="@color/accent_text" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
    <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/wallet_currency_label" android:layout_marginTop="8dp" />
    <com.subhub.app.util.CompactChoiceGroup android:id="@+id/wallet_currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/wallet_currency_eur" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wallet_currency_eur" style="@style/Widget.SubHub.OptionRadio" />
        <RadioButton android:id="@+id/wallet_currency_usd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wallet_currency_usd" style="@style/Widget.SubHub.OptionRadio" />
    </com.subhub.app.util.CompactChoiceGroup>
    <TextView android:id="@+id/wallet_currency_status" style="@style/Widget.SubHub.FieldHelp" android:text="@string/wallet_currency_help" />
    <Button android:id="@+id/button_refresh_wallet_currency" style="@style/Widget.SubHub.CompactOutlineButton" android:layout_width="match_parent" android:text="@string/wallet_currency_refresh" />
    <TextView android:labelFor="@id/paypal_client_id" style="@style/Widget.SubHub.FieldLabel" android:text="@string/paypal_client_id_label" android:layout_marginTop="8dp" />
    <EditText style="@style/Widget.SubHub.Input" android:id="@+id/paypal_client_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:hint="@string/paypal_client_id_hint" android:inputType="textNoSuggestions" android:singleLine="true" />
    <TextView android:labelFor="@id/paypal_client_secret" style="@style/Widget.SubHub.FieldLabel" android:text="@string/paypal_client_secret_label" android:layout_marginTop="8dp" />
    <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/paypal_client_secret_help" />
    <EditText style="@style/Widget.SubHub.Input" android:id="@+id/paypal_client_secret" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:hint="@string/paypal_client_secret_hint" android:inputType="textPassword" android:singleLine="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_control" android:orientation="horizontal">
        <Button android:id="@+id/button_save_paypal_sandbox" style="@style/Widget.SubHub.CompactOutlineButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/paypal_sandbox_save" />
        <Button android:id="@+id/button_clear_paypal_sandbox" style="@style/Widget.SubHub.CompactOutlineButton" android:layout_width="0dp" android:layout_marginStart="@dimen/ui_gap_control" android:layout_weight="1" android:text="@string/paypal_sandbox_clear" />
    </LinearLayout>
    <TextView style="@style/Widget.SubHub.FieldHelp" android:layout_marginTop="8dp" android:text="@string/paypal_vault_help" />
    <TextView android:id="@+id/paypal_vault_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/accent_text" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
    <Button android:id="@+id/button_link_paypal_wallet" style="@style/Widget.SubHub.CompactOutlineButton" android:layout_width="match_parent" android:layout_marginTop="@dimen/ui_gap_control" android:text="@string/paypal_wallet_link" />
    <com.subhub.app.util.StateToggle android:id="@+id/paypal_auto_pay_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/paypal_auto_pay_enable" />
    <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/paypal_auto_pay_help" />
    <TextView android:id="@+id/paypal_auto_pay_status" style="@style/Widget.SubHub.FieldHelp" android:layout_marginTop="@dimen/ui_gap_inline" android:textColor="@color/accent_hot" android:visibility="gone" />
    <TextView android:labelFor="@id/paypal_link" style="@style/Widget.SubHub.FieldLabel" android:text="@string/paypal_link_label" android:layout_marginTop="8dp" />
    <EditText style="@style/Widget.SubHub.Input" android:id="@+id/paypal_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:hint="@string/paypal_link_hint" android:inputType="textUri" android:singleLine="true" />
    <Button android:id="@+id/button_save_paypal" style="@style/Widget.SubHub.PrimaryButton" android:layout_marginTop="8dp" android:text="@string/paypal_settings_save" />
</LinearLayout>
