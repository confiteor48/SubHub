<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/control_checked_outline" />
            <corners android:radius="@dimen/ui_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_raised" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="@dimen/ui_card_radius" />
        </shape>
    </item>
</selector>
