<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/ui_card_radius" />
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_mid" />
            <padding android:left="@dimen/ui_card_padding" android:top="@dimen/ui_gap_group"
                android:right="@dimen/ui_card_padding" android:bottom="@dimen/ui_gap_group" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_card_radius" />
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="@color/outline_default" />
            <padding android:left="@dimen/ui_card_padding" android:top="@dimen/ui_gap_group"
                android:right="@dimen/ui_card_padding" android:bottom="@dimen/ui_gap_group" />
        </shape>
    </item>
</selector>
