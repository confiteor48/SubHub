<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_disabled" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="@dimen/ui_input_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="2dp" android:color="@color/outline_focus" />
            <corners android:radius="@dimen/ui_input_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="@dimen/ui_input_radius" />
        </shape>
    </item>
</selector>
